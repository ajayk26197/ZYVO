# =============================================
#   ZYVO FOOD DELIVERY — SERVER CONFIG
# =============================================

# Server Port and Environment
PORT=5001
NODE_ENV=production

# ─────────────────────────────────────────────
# MongoDB Atlas Database URI
# ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/zyvo?retryWrites=true&w=majority

# ─────────────────────────────────────────────
# JWT Authentication Secret & Expiration
# ─────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# ─────────────────────────────────────────────
# Cloudinary (Optional Image Uploads)
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─────────────────────────────────────────────
# Stripe (Optional Payments)
# ─────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ─────────────────────────────────────────────
# Client URL / CORS Whitelist
# (Comma separated for multiple: e.g. https://zyvo.vercel.app,http://localhost:3000)
# ─────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
